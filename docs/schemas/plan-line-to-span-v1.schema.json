{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/plan-line-to-span/v1/schema.json",
  "title": "Plan Line to Span v1 messages",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "version": { "const": "plan-line-to-span/v1" },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "dimensionMap": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "dimensionValue": {
      "type": "object",
      "required": ["key", "name"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parentKey": { "type": "string", "minLength": 1 }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["id", "name", "values"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "items": { "$ref": "#/$defs/dimensionValue" } }
      }
    },
    "dimensionDefinition": {
      "type": "object",
      "required": ["format", "dimensions"],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1,
          "$comment": "The structural boundary requires a string; domain meaning is caller-owned."
        },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/dimension" } }
      }
    },
    "spanPayload": {
      "type": "object",
      "required": ["span"],
      "additionalProperties": false,
      "properties": { "span": { "$ref": "#/$defs/dimensionMap" } }
    },
    "updateSpanPayload": {
      "type": "object",
      "required": ["span", "replacementSpan"],
      "additionalProperties": false,
      "properties": {
        "span": { "$ref": "#/$defs/dimensionMap" },
        "replacementSpan": { "$ref": "#/$defs/dimensionMap" }
      }
    },
    "planLinePayload": {
      "type": "object",
      "required": ["dimensions"],
      "additionalProperties": false,
      "properties": { "dimensions": { "$ref": "#/$defs/dimensionMap" } }
    },
    "initializeData": {
      "type": "object",
      "required": ["state", "dimensionCount", "spanCount"],
      "additionalProperties": false,
      "properties": {
        "state": { "const": "ready" },
        "dimensionCount": { "type": "integer", "minimum": 0 },
        "spanCount": { "const": 0 }
      }
    },
    "spanData": {
      "type": "object",
      "required": ["span"],
      "additionalProperties": false,
      "properties": { "span": { "$ref": "#/$defs/dimensionMap" } }
    },
    "deleteData": {
      "type": "object",
      "required": ["deleted", "span"],
      "additionalProperties": false,
      "properties": {
        "deleted": { "const": true },
        "span": { "$ref": "#/$defs/dimensionMap" }
      }
    },
    "planLineData": {
      "type": "object",
      "required": ["matches"],
      "additionalProperties": false,
      "properties": {
        "matches": { "type": "array", "items": { "$ref": "#/$defs/dimensionMap" } }
      }
    },
    "request": {
      "type": "object",
      "required": ["contractVersion", "operation", "payload"],
      "additionalProperties": false,
      "properties": {
        "contractVersion": { "$ref": "#/$defs/version" },
        "operation": { "enum": ["initialize", "createSpan", "updateSpan", "deleteSpan", "querySpan", "queryPlanLine"] },
        "requestId": { "$ref": "#/$defs/requestId" },
        "payload": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "initialize" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/dimensionDefinition" } } } },
        { "if": { "properties": { "operation": { "enum": ["createSpan", "deleteSpan", "querySpan"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/spanPayload" } } } },
        { "if": { "properties": { "operation": { "const": "updateSpan" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/updateSpanPayload" } } } },
        { "if": { "properties": { "operation": { "const": "queryPlanLine" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/planLinePayload" } } } }
      ]
    },
    "successResponse": {
      "type": "object",
      "required": ["contractVersion", "operation", "ok", "data"],
      "additionalProperties": false,
      "properties": {
        "contractVersion": { "$ref": "#/$defs/version" },
        "operation": { "enum": ["initialize", "createSpan", "updateSpan", "deleteSpan", "querySpan", "queryPlanLine"] },
        "requestId": { "$ref": "#/$defs/requestId" },
        "ok": { "const": true },
        "data": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "operation": { "const": "initialize" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/initializeData" } } } },
        { "if": { "properties": { "operation": { "enum": ["createSpan", "updateSpan", "querySpan"] } } }, "then": { "properties": { "data": { "$ref": "#/$defs/spanData" } } } },
        { "if": { "properties": { "operation": { "const": "deleteSpan" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/deleteData" } } } },
        { "if": { "properties": { "operation": { "const": "queryPlanLine" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/planLineData" } } } }
      ]
    },
    "errorResponse": {
      "type": "object",
      "required": ["contractVersion", "ok", "error"],
      "additionalProperties": false,
      "properties": {
        "contractVersion": { "$ref": "#/$defs/version" },
        "operation": { "enum": ["initialize", "createSpan", "updateSpan", "deleteSpan", "querySpan", "queryPlanLine"] },
        "requestId": { "$ref": "#/$defs/requestId" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "enum": ["MALFORMED_REQUEST", "DUPLICATE_SPAN", "NOT_FOUND", "INVALID_STATE"] },
            "message": { "type": "string", "minLength": 1 },
            "details": { "type": "object", "additionalProperties": true }
          }
        }
      }
    }
  }
}
